local log = require("log.log")

-- All loggers → one shared file (also configured via game.project [log] file = ...)
-- log.set_file("logs/game.log")

local logger = log.get_logger("logger", "TRACE")
-- Optional: also write this logger to a file next to the script
logger:write_nearby_this_file()

local function expensiveOperation()
	for index = 1, 1000000 do
		local a = { a = "s" }
	end
end


function init(self)
	-- Optional: wipe previous session's known .log files
	log.clear_log_files()

	-- Custom callback example (file writing is handled via set_file / write_nearby)
	log.add_callback(function(logger_instance, level, message, context, log_message)
		if level == "ERROR" then
			print("[callback] captured error from", logger_instance.name)
		end
	end)

	log:trace("trace", { key = "value" })
	log:info("info", { key = "value" })
	log:debug("debug", { key = "value" })
	log:warn("warn", { key = "value" })
	log:error("error", { key = "value" })

	----

	logger:trace("init")

	logger:debug("Debug message", {
		value = 2, debug = "message"
	})

	logger:info("Here is some info", logger)
	logger:warn("This is a warning", log)
	logger:error("This is an error", "just string")

	logger:trace("Trace message")
	logger:debug("Debug message", {key = "value"})
	logger:info("Info message", {key = "value"})
	logger:warn("Warn message", {key = "value"})
	logger:error("Error message", {key = "value"})

	logger:info("Table to string", { inner_table = {
		a = 1,
		b = 2,
		c = { d = 3, e = 4 }
	}})

	logger:trace("Before expensive operation")
	expensiveOperation()
	logger:trace("After expensive operation")

	-- Silent tracking tick: nil message updates memory/time without printing
	logger:debug()

	local counter = 0
	timer.delay(0.01, true, function()
		counter = counter + 1
	end)
	timer.delay(1, true, function()
		logger:info("Counter", counter)
	end)
end


function final(self)
	log.final()
end
