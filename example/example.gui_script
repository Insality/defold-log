local log = require("log.log")

-- All loggers write to one shared file. The same can be set in game.project: [log] file = ...
-- log.set_file("logs/game.log")

local logger = log.get_logger("game.example")
local logger_two = log.get_logger("game.example2", "WARN")

-- Additionally write this logger to game.example.log next to this script
logger:set_file_nearby()

local function expensive_operation()
	for index = 1, 1000000 do
		local a = { a = "s" }
	end
end


function init(self)
	-- Remove the log files from the previous launch
	log.clear_log_files()

	log.add_callback(function(logger_instance, level, message, context, log_message)
		if level == "ERROR" then
			print("[callback] captured error from", logger_instance.name)
		end
	end)

	-- The log module itself is a logger, its name is the current script name
	log:trace("trace", { key = "value" })
	log:info("info", { key = "value" })
	log:debug("debug", { key = "value" })
	log:warn("warn", { key = "value" })
	log:error("error", { key = "value" })

	----

	logger:trace("Trace message")
	logger:debug("Debug message", { value = 2, debug = "message" })
	logger:info("Info message", { key = "value" })
	logger:warn("Warn message", { key = "value" })
	logger:error("Error message", "just string")

	-- This logger is forced to WARN, so trace and info are skipped
	logger_two:trace("Trace message")
	logger_two:info("Info message")
	logger_two:warn("Warn message")

	logger:info("Table to string", { inner_table = {
		a = 1,
		b = 2,
		c = { d = 3, e = 4 }
	}})

	logger:trace("Before expensive operation")
	expensive_operation()
	logger:trace("After expensive operation")

	-- A nil message refreshes the memory/time tracking without any output
	logger:debug()

	local counter = 0
	timer.delay(0.01, true, function()
		counter = counter + 1
	end)
	timer.delay(1, true, function()
		logger:info("Counter", counter)
	end)
end


function final(self)
	log.final()
end
